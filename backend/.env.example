# Copy this file to .env and fill in real values. NEVER commit the real .env.

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/justiceflow

# Gemini API key (backend only — never expose to React)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173
